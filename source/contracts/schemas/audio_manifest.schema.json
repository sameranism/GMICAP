{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.etemad.example/schemas/audio_manifest.schema.json",
  "title": "audio_manifest",
  "description": "خروجی صوتی تولیدشده و زیرنویس.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "audio_id": {
      "type": "string",
      "minLength": 1
    },
    "source_object_type": {
      "type": "string",
      "enum": [
        "article",
        "public_report"
      ]
    },
    "source_object_id": {
      "type": "string",
      "minLength": 1
    },
    "audio_uri": {
      "type": "string",
      "minLength": 1
    },
    "subtitle_uri": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "voice_id": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "ai_generated": {
      "type": "boolean",
      "const": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "audio_id",
    "source_object_type",
    "source_object_id",
    "audio_uri",
    "subtitle_uri",
    "voice_id",
    "language",
    "ai_generated",
    "created_at"
  ],
  "additionalProperties": false
}
