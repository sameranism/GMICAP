{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.etemad.example/schemas/archive_record.schema.json",
  "title": "archive_record",
  "description": "رکورد آرشیو با سطح محرمانگی و سیاست نگهداری.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "archive_id": {
      "type": "string",
      "minLength": 1
    },
    "object_type": {
      "type": "string",
      "minLength": 1
    },
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "stream": {
      "type": "string",
      "enum": [
        "domestic",
        "foreign",
        "mixed",
        "manual"
      ]
    },
    "classification": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "restricted",
        "executive_private"
      ]
    },
    "payload_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "retention_policy_id": {
      "type": "string",
      "minLength": 1
    },
    "stored_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "archive_id",
    "object_type",
    "object_id",
    "stream",
    "classification",
    "payload_ref",
    "source_refs",
    "retention_policy_id",
    "stored_at"
  ],
  "additionalProperties": false
}
