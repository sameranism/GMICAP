{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.etemad.example/schemas/image_manifest.schema.json",
  "title": "image_manifest",
  "description": "فهرست فایل‌های تصویری و مجوز استفاده مستقل از محتوا.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "article_id": {
      "type": "string",
      "minLength": 1
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "format": {
            "type": "string",
            "enum": [
              "jpg",
              "png",
              "webp"
            ]
          },
          "license_status": {
            "type": "string",
            "enum": [
              "verified",
              "unknown",
              "restricted"
            ]
          },
          "ai_generated": {
            "type": "boolean"
          },
          "alt_text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "uri",
          "width",
          "height",
          "format",
          "license_status",
          "ai_generated",
          "alt_text"
        ],
        "additionalProperties": false
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "article_id",
    "assets",
    "created_at"
  ],
  "additionalProperties": false
}
