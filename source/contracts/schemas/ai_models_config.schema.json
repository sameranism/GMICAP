{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.etemad.example/schemas/ai_models_config.schema.json",
  "title": "ai_models_config",
  "description": "پیکربندی مدل‌ها بدون ذخیره مستقیم کلید API.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "configuration_id": {
      "type": "string",
      "minLength": 1
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "credential_ref": {
            "type": "string",
            "minLength": 1
          },
          "max_daily_cost_usd": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "task",
          "provider",
          "model",
          "credential_ref",
          "max_daily_cost_usd"
        ],
        "additionalProperties": false
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "configuration_id",
    "tasks",
    "updated_at"
  ],
  "additionalProperties": false
}
