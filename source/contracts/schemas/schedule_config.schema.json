{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.etemad.example/schemas/schedule_config.schema.json",
  "title": "schedule_config",
  "description": "برنامه مستقل هر جریان/سرویس، با زمان محلی فقط در مرحله تنظیم.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "config_id": {
      "type": "string",
      "minLength": 1
    },
    "stream": {
      "type": "string",
      "enum": [
        "domestic",
        "foreign",
        "mixed"
      ]
    },
    "desk": {
      "type": "string",
      "minLength": 1
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "immediate",
        "fixed_times",
        "interval"
      ]
    },
    "fixed_times_local": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
      }
    },
    "interval_minutes": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "enabled": {
      "type": "boolean"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "config_id",
    "stream",
    "desk",
    "timezone",
    "mode",
    "fixed_times_local",
    "interval_minutes",
    "enabled",
    "updated_at"
  ],
  "additionalProperties": false
}
