{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.etemad.example/schemas/metrics_snapshot.schema.json",
  "title": "metrics_snapshot",
  "description": "اعداد قابل گزارش از داده واقعی برای پنل و گزارش‌ها.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "stream": {
      "type": "string",
      "enum": [
        "domestic",
        "foreign",
        "mixed",
        "manual"
      ]
    },
    "time_range": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time"
        },
        "to": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "collected_count": {
      "type": "integer",
      "minimum": 0
    },
    "unique_count": {
      "type": "integer",
      "minimum": 0
    },
    "published_count": {
      "type": "integer",
      "minimum": 0
    },
    "successful_deliveries": {
      "type": "integer",
      "minimum": 0
    },
    "failed_deliveries": {
      "type": "integer",
      "minimum": 0
    },
    "unknown_deliveries": {
      "type": "integer",
      "minimum": 0
    },
    "topic_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "topic",
          "count"
        ],
        "additionalProperties": false
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "snapshot_id",
    "stream",
    "time_range",
    "collected_count",
    "unique_count",
    "published_count",
    "successful_deliveries",
    "failed_deliveries",
    "unknown_deliveries",
    "topic_coverage",
    "generated_at"
  ],
  "additionalProperties": false
}
