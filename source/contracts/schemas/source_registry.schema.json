{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.etemad.example/schemas/source_registry.schema.json",
  "title": "source_registry",
  "description": "فهرست منابع رسمی رصد با شناسه اعتبارنامه، بدون ذخیره خود کلید.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "registry_id": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "site_url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "feed_url": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^https?://"
              },
              {
                "type": "null"
              }
            ]
          },
          "api_base_url": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^https?://"
              },
              {
                "type": "null"
              }
            ]
          },
          "country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "language": {
            "type": "string",
            "minLength": 1
          },
          "stream": {
            "type": "string",
            "enum": [
              "domestic",
              "foreign"
            ]
          },
          "auth_ref": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "license_scope": {
            "type": "string",
            "enum": [
              "metadata",
              "summary",
              "full_text",
              "unknown"
            ]
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "source_id",
          "site_url",
          "country",
          "language",
          "stream",
          "license_scope",
          "enabled"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "registry_id",
    "updated_at",
    "sources"
  ],
  "additionalProperties": false
}
