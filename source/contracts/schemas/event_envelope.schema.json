{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.etemad.example/schemas/event_envelope.schema.json",
  "title": "event_envelope",
  "description": "پیام هماهنگی بین پروژه‌ها، شامل ارجاع به payload نه داده محرمانه.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "producer_project": {
      "type": "string",
      "pattern": "^P(0[1-9]|[12][0-9])$"
    },
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "classification": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "restricted",
        "executive_private"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "producer_project",
    "object_id",
    "correlation_id",
    "idempotency_key",
    "classification",
    "occurred_at",
    "payload_ref"
  ],
  "additionalProperties": false
}
