{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.etemad.example/schemas/cluster_result.schema.json",
  "title": "cluster_result",
  "description": "نتیجه تشخیص تکرار و گروه‌بندی رویداد، بدون حذف منبع اصلی.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "news_id": {
      "type": "string",
      "minLength": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "duplicate_of": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "related_news_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "similarity_method": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "news_id",
    "event_id",
    "duplicate_of",
    "related_news_ids",
    "similarity_method",
    "created_at"
  ],
  "additionalProperties": false
}
